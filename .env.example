# Dominio de la app en este servidor (el mismo del front; el back responde bajo /api).
APP_HOST=fleetier.vpn.reuno.cl

# Credenciales de la base: las mismas del .env de bd-fleetier.
DB_NAME=fleetier
DB_USER=fleetier
DB_PASSWORD=

# Contraseña con que parte toda cuenta nueva o restablecida (mínimo 8 caracteres).
# La persona debe cambiarla en su primer ingreso.
CLAVE_INICIAL=

# Correo del primer administrador. Solo se usa si todavía no existe ningún admin:
# el back crea esa cuenta al partir, con la contraseña inicial.
ADMIN_CORREO=

# Secreto con que se cifran las contraseñas de las cuentas de los conductores
# (mínimo 16 caracteres, al azar: `openssl rand -base64 32`). No se cambia una
# vez en uso: lo ya guardado quedaría ilegible. Si falta, el back parte igual,
# pero esas cuentas no se pueden guardar ni leer.
CLAVE_CUENTAS=

# Documentación interactiva de la API en /api/docs (Swagger). "true" la prende;
# vacío o cualquier otro valor la deja apagada. Conviene apagada en producción.
SWAGGER_HABILITADO=

# --- Solo para correr el back fuera de Docker (npm run start:dev) ---
# El compose arma estas variables solo, a partir de las de arriba; fuera de
# Docker hay que darlas aquí. `npm run start:dev` lee este archivo.
# Los valores de ejemplo son los de la base temporal de ../local.sh.
PGHOST=127.0.0.1
PGPORT=55434
PGDATABASE=fleetier
PGUSER=fleetier
PGPASSWORD=
