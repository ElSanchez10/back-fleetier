# Dominio de la app en este servidor (el mismo del front; el back responde bajo /api).
APP_HOST=dsl.vpn.reuno.cl

# Credenciales de la base: las mismas del .env de bd-dsl.
DB_NAME=dsl
DB_USER=dsl
DB_PASSWORD=

# Contraseña con que parte toda cuenta nueva o restablecida (mínimo 8 caracteres).
# La persona debe cambiarla en su primer ingreso.
CLAVE_INICIAL=

# Correo del primer administrador. Solo se usa si todavía no existe ningún admin:
# el back crea esa cuenta al partir, con la contraseña inicial.
ADMIN_CORREO=

# --- Solo para correr el back fuera de Docker (npm run start:dev) ---
# El compose arma estas variables solo, a partir de las de arriba; fuera de
# Docker hay que darlas aquí. `npm run start:dev` lee este archivo.
# Los valores de ejemplo son los de la base temporal de ../local.sh.
PGHOST=127.0.0.1
PGPORT=55433
PGDATABASE=dsl
PGUSER=dsl
PGPASSWORD=
